{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gis20",
	"main": "worker/src/index.ts",
	"compatibility_date": "2026-06-01",
	"observability": {
		"enabled": true
	},
	// The Astro build; every request goes through the Worker (www redirect, /api, noindex header).
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": true
	},
	// Custom domains: Cloudflare creates the DNS records and certificates for both hostnames.
	"routes": [
		{ "pattern": "gis20.cz", "custom_domain": true },
		{ "pattern": "www.gis20.cz", "custom_domain": true }
	],
	// wrangler dev sends requests as https://gis20.cz (the first route); over http the Worker would redirect them.
	"dev": { "upstream_protocol": "https" },
	"vars": {
		"MAIL_FROM": "Sraz gisáků <sraz@gis20.cz>",
		"SITE_URL": "https://gis20.cz/",
		"ALLOWED_ORIGINS": "https://gis20.cz,https://www.gis20.cz,http://localhost:4321"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gis20-rsvp",
			"database_id": "dc782ed1-1d2a-4099-b721-1c33feb36cd5"
		}
	]
	// RESEND_API_KEY is a secret: npx wrangler secret put RESEND_API_KEY
	// Schema of the database: worker/schema.sql
}