---
import { event } from '../data/event';
import Scrap from './Scrap.astro';

// RSVP as a cut-out coupon, backed by the Cloudflare Worker in /worker (see rsvpApi in event.ts).
// Guests answer coming / not coming. The confirmation e-mail carries two personal links: the attendance sheet
// (https://gis20.cz/#listina=<token>, names only) and a link to change the answer either way (#odpoved=<token>;
// #odhlasit=<token> from older e-mails opens the same panel).
// Without a configured API the slip only renders in dev, so production never shows a dead form.
const api = event.rsvpApi.trim().replace(/\/$/, '');
const visible = Boolean(api) || import.meta.env.DEV;
// Boxed inputs with dark labels: readable, clear borders (WCAG non-text contrast) and a visible focus ring.
const label = 'block text-base font-semibold';
const field =
	'mt-1.5 block w-full rounded-sm border-2 border-ink/70 bg-white px-3 py-2 text-lg leading-snug font-normal text-ink placeholder:text-ink-soft/70 focus:border-ink focus:outline-3 focus:outline-offset-1 focus:outline-water';
const button =
	'border-2 border-ink bg-ink px-5 py-2.5 font-cond text-lg font-semibold text-news transition-colors hover:border-trail hover:bg-trail disabled:opacity-60';
// Answer buttons: the whole box is the radio's label, the checked one turns dark.
const choice =
	'flex cursor-pointer items-center gap-2.5 rounded-sm border-2 border-ink/70 bg-white px-3 py-2 text-lg font-semibold has-checked:border-ink has-checked:bg-ink has-checked:text-news has-focus-visible:outline-3 has-focus-visible:outline-offset-1 has-focus-visible:outline-water';
// The same look for the answer buttons on the personal answer panel; the current answer is pressed.
const choiceButton =
	'flex cursor-pointer items-center justify-center rounded-sm border-2 border-ink/70 bg-white px-3 py-2 text-lg font-semibold transition-colors hover:border-ink aria-pressed:cursor-default aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-news disabled:opacity-60';
const stamp =
	'inline-block -rotate-6 border-4 border-double border-trail/80 px-5 py-2 font-cond text-2xl font-semibold tracking-wide text-trail/90 uppercase';
---

{
	visible && (
		<section id="prihlaska" aria-labelledby="prihlaska-nadpis" class="mt-24 flex scroll-mt-8 justify-center" data-rsvp-api={api}>
			<Scrap
				seed={30}
				rotate={-1.2}
				edges="cut"
				paper="#fffdf6"
				attach="tape"
				class="w-full max-w-xl"
				innerClass="p-3"
			>
				<div class="border-2 border-dashed border-ink/60 px-6 pt-5 pb-7 sm:px-8">
					<p class="text-sm text-ink-soft italic" aria-hidden="true">
						✂ zde odstřihněte
					</p>
					<div class="mt-2 flex items-start justify-between gap-4">
						<div>
							<h2 id="prihlaska-nadpis" class="text-[2rem] leading-tight font-bold">
								Přihláška
							</h2>
							<p class="mt-1 text-lg">
								na sraz {event.start.d}.–{event.end.d}.&nbsp;{event.start.m}.&nbsp;{event.start.y}, {event.venue.toLowerCase()},{' '}
								<span class="whitespace-nowrap">{event.town}</span>
							</p>
						</div>
						{/* Head count as a tag pinned to the coupon's corner; filled in by the script. */}
						<p data-rsvp-count hidden class="mt-1 shrink-0 rotate-3 rounded-sm border-2 border-ink/80 bg-news px-3 pt-1.5 pb-2 text-center leading-none shadow-sm">
							<strong class="block font-cond text-4xl font-semibold" />
							<span class="mt-1 block text-xs tracking-wide text-ink-soft uppercase">přihlášeno</span>
						</p>
					</div>
					{event.rsvpDeadline && (
						<p class="mt-2">
							Přihlaste se prosím do <strong>{event.rsvpDeadline}</strong>.
						</p>
					)}

					{/* Opened from the personal answer link in the confirmation e-mail. */}
					<div data-rsvp-answer hidden class="mt-6">
						<p class="text-lg">Odpověď pro <strong data-rsvp-answer-name />:</p>
						<div class="mt-3 grid grid-cols-2 gap-3" role="group" aria-label="Přijedete?">
							<button type="button" data-rsvp-answer-choice="yes" aria-pressed="false" class={choiceButton}>Přijedu</button>
							<button type="button" data-rsvp-answer-choice="no" aria-pressed="false" class={choiceButton}>Nepřijedu</button>
						</div>
						<div data-rsvp-answer-saved hidden class="mt-6" role="status">
							<p class={stamp} data-rsvp-answer-stamp />
							<p class="mt-4 text-lg" data-rsvp-answer-text />
						</div>
						<p class="mt-5">
							<a data-rsvp-answer-sheet href="#" class="underline decoration-1 underline-offset-4 transition-colors hover:text-trail">
								Prezenční listina: kdo všechno přijede →
							</a>
						</p>
					</div>

					<form data-rsvp-form class="mt-6 grid gap-x-5 gap-y-4 sm:grid-cols-2" autocomplete="on">
						<fieldset class="sm:col-span-2">
							<legend class={label}>Přijedete?</legend>
							<div class="mt-1.5 grid grid-cols-2 gap-3">
								<label class={choice}>
									<input type="radio" name="attending" value="yes" checked class="size-4 accent-trail" />
									Přijedu
								</label>
								<label class={choice}>
									<input type="radio" name="attending" value="no" class="size-4 accent-trail" />
									Nepřijedu
								</label>
							</div>
						</fieldset>
						<label class:list={[label, 'sm:col-span-2']}>
							Jméno a příjmení / přezdívka
							<input class={field} type="text" name="name" autocomplete="name" required minlength="2" maxlength="80" />
						</label>
						<label class={label}>
							E-mail
							<input class={field} type="email" name="email" autocomplete="email" inputmode="email" required maxlength="254" />
						</label>
						<label class={label}>
							Telefon
							<input
								class={field}
								type="tel"
								name="phone"
								autocomplete="tel"
								inputmode="tel"
								required
								pattern="[+0-9 ]{9,20}"
								title="Telefonní číslo, např. 777 123 456 nebo +420 777 123 456"
							/>
						</label>
						<div class="sm:col-span-2">
							<label for="rsvp-note" class={label}>
								Poznámka <span class="font-normal text-ink-soft">(nepovinné)</span>
							</label>
							<p id="rsvp-note-hint" class="text-sm text-ink-soft">Strava, nocleh, spolujízda nebo cokoliv dalšího, co nám chcete napsat.</p>
							<textarea id="rsvp-note" class:list={[field, 'resize-y']} name="note" rows="3" maxlength="500" aria-describedby="rsvp-note-hint" />
						</div>
						{/* Honeypot for bots, hidden from people and screen readers. */}
						<label class="absolute -left-[9999px]" aria-hidden="true">
							Nevyplňujte
							<input type="text" name="hp_check" tabindex="-1" autocomplete="off" />
						</label>
						<div class="flex flex-wrap items-center gap-x-5 gap-y-3 pt-1 sm:col-span-2">
							<button type="submit" class={button}>
								Potvrdit účast
							</button>
							<p class="max-w-xs text-sm text-ink-soft">
								Vaše jméno uvidí ostatní přihlášení na prezenční listině, e-mail a telefon jen organizátoři.
							</p>
						</div>
					</form>

					<div data-rsvp-done hidden class="mt-6">
						<div data-rsvp-done-yes>
							<p class={stamp}>Zapsáno</p>
							<p class="mt-4 text-lg">Díky, počítáme s vámi! Uvidíme se ve sklepě.</p>
						</div>
						<div data-rsvp-done-no hidden>
							<p class={stamp}>Omluvenka</p>
							<p class="mt-4 text-lg">
								Škoda, budete chybět! Kdyby se to změnilo, odpověď změníte přes odkaz v e-mailu.
							</p>
						</div>
						<p data-rsvp-mailed class="mt-2 text-sm text-ink-soft">
							Na e-mail přišel odkaz na prezenční listinu, kde uvidíte, kdo všechno přijede, a odkaz na změnu odpovědi.
						</p>
						<p data-rsvp-unmailed hidden class="mt-2 text-sm text-ink-soft">
							Potvrzovací e-mail se teď nepodařilo odeslat, odpověď je ale zapsaná. Až budete chtít odkazy, odešlete prosím
							formulář znovu se stejným e-mailem.
						</p>
					</div>

					{/* Opened from the personal sheet link in the confirmation e-mail. Rows are filled in by the script. */}
					<div data-rsvp-sheet hidden class="mt-6 border-2 border-ink/70 bg-white">
						<div class="border-b-2 border-ink/70 px-4 py-2">
							<h3 class="font-cond text-xl font-semibold tracking-wide uppercase">Prezenční listina</h3>
							<p class="text-sm text-ink-soft">Vidí ji jen ti, kdo vyplnili přihlášku. Odkaz prosím nikomu neposílejte.</p>
						</div>
						<table class="w-full border-collapse text-left">
							<thead>
								<tr class="border-b border-ink/40 text-sm text-ink-soft">
									<th scope="col" class="w-10 px-2 py-1 text-right font-normal">č.</th>
									<th scope="col" class="border-l-2 border-trail/50 px-3 py-1 font-normal">Jméno</th>
									<th scope="col" class="w-20 px-2 py-1 text-center font-normal">Účast</th>
								</tr>
							</thead>
							<tbody data-rsvp-sheet-rows />
						</table>
						<p data-rsvp-sheet-sum class="border-t-2 border-ink/70 px-4 py-2 text-sm" />
					</div>

					<details data-rsvp-lost class="mt-6">
						<summary class="cursor-pointer underline decoration-1 underline-offset-4">
							Potřebujete změnit odpověď nebo vidět prezenční listinu? Pošleme vám odkazy
						</summary>
						<form data-rsvp-link-form class="mt-3 flex flex-wrap items-end gap-4">
							<label class:list={[label, 'min-w-56 flex-1']}>
								E-mail, se kterým jste se přihlásili
								<input class={field} type="email" name="email" autocomplete="email" inputmode="email" required maxlength="254" />
							</label>
							<button type="submit" class="border-2 border-ink px-4 py-2.5 font-cond text-lg font-semibold transition-colors hover:bg-ink hover:text-news disabled:opacity-60">
								Poslat odkaz
							</button>
						</form>
						<p data-rsvp-link-sent hidden class="mt-3">
							Pokud e-mail u nás máme, přišly na něj odkazy na prezenční listinu a na změnu odpovědi.
						</p>
					</details>

					<p data-rsvp-error hidden class="mt-4 font-semibold text-trail" role="alert" />

					{(event.contactEmail || event.contactPhone) && (
						<p class="mt-6 border-t border-ink/20 pt-3 text-sm text-ink-soft">
							Dotazy:{' '}
							{event.contactEmail && (
								<a class="underline" href={`mailto:${event.contactEmail}`}>
									{event.contactEmail}
								</a>
							)}
							{event.contactEmail && event.contactPhone && ', '}
							{event.contactPhone && (
								<a class="underline" href={`tel:${event.contactPhone.replace(/\s/g, '')}`}>
									{event.contactPhone}
								</a>
							)}
						</p>
					)}
					{event.paymentInfo && <p class="mt-3 text-sm">{event.paymentInfo}</p>}
				</div>
			</Scrap>
		</section>
	)
}

<script>
	const root = document.querySelector<HTMLElement>('[data-rsvp-api]');
	if (root) setup(root);

	type Person = { name: string; coming: boolean; you: boolean };

	function setup(root: HTMLElement) {
		const api = root.dataset.rsvpApi ?? '';
		const $ = <T extends HTMLElement>(name: string) => root.querySelector<T>(`[data-rsvp-${name}]`)!;
		const form = $<HTMLFormElement>('form');
		const error = $('error');
		const countLine = $('count');

		const show = (el: HTMLElement, on = true) => (el.hidden = !on);
		const fail = (message: string) => {
			error.textContent = message;
			show(error);
		};
		const setCount = (n: unknown) => {
			if (typeof n !== 'number') return;
			countLine.querySelector('strong')!.textContent = String(n);
			show(countLine, n > 0);
		};

		async function call(path: string, body?: object) {
			if (!api) throw new Error('Přihláška zatím není napojená na server (vidíte to jen při vývoji).');
			const response = await fetch(api + path, body ? { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) } : {});
			const data = await response.json().catch(() => ({}));
			if (!response.ok) throw new Error(data.error ?? 'Něco se pokazilo, zkuste to prosím později.');
			return data;
		}
		const offline = 'Nepodařilo se spojit se serverem. Zkontrolujte připojení k internetu a zkuste to znovu.';
		const message = (e: unknown) => (e instanceof TypeError ? offline : e instanceof Error ? e.message : offline);

		call('/count')
			.then((data) => setCount(data.count))
			.catch(() => {});

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			if (!form.reportValidity()) return;
			show(error, false);
			const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
			button.disabled = true;
			try {
				const data = await call('/register', Object.fromEntries(new FormData(form)));
				const coming = data.status !== 'no';
				show(form, false);
				show($('lost'), data.mailed === false);
				show($('done-yes'), coming);
				show($('done-no'), !coming);
				show($('mailed'), data.mailed !== false);
				show($('unmailed'), data.mailed === false);
				show($('done'));
				setCount(data.count);
			} catch (err) {
				fail(message(err));
				button.disabled = false;
			}
		});

		// The submit button follows the answer.
		const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
		const syncAnswer = () => {
			const coming = (form.elements.namedItem('attending') as RadioNodeList).value !== 'no';
			submit.textContent = coming ? 'Potvrdit účast' : 'Odeslat omluvenku';
		};
		form.addEventListener('change', syncAnswer);
		syncAnswer();

		const linkForm = $<HTMLFormElement>('link-form');
		linkForm.addEventListener('submit', async (e) => {
			e.preventDefault();
			if (!linkForm.reportValidity()) return;
			show(error, false);
			const button = linkForm.querySelector<HTMLButtonElement>('button')!;
			button.disabled = true;
			try {
				await call('/answer-link', Object.fromEntries(new FormData(linkForm)));
				show(linkForm, false);
				show($('link-sent'));
			} catch (err) {
				fail(message(err));
				button.disabled = false;
			}
		});

		// Personal links from the e-mail only change the hash, which doesn't reload an already open page.
		addEventListener('hashchange', () => {
			if (/^#(odpoved|odhlasit|listina)=/.test(location.hash)) location.reload();
		});

		// Attendance sheet link from the e-mail: https://gis20.cz/#listina=<token>
		const sheetToken = location.hash.match(/^#listina=([a-f0-9]{16,64})$/)?.[1];
		if (sheetToken) {
			show(form, false);
			show($('lost'), false);
			root.scrollIntoView();
			call('/attendees', { token: sheetToken })
				.then((data: { people: Person[] }) => renderSheet(data.people))
				.catch((err) => fail(message(err)));
		}

		function renderSheet(people: Person[]) {
			const rows = $('sheet-rows');
			// Names come from other guests: only ever set as text, never as HTML.
			people.forEach((person, i) => {
				const tr = document.createElement('tr');
				tr.className = 'border-b border-ink/15' + (person.you ? ' bg-sticky/40' : '');
				const number = document.createElement('td');
				number.className = 'px-2 py-1 text-right text-sm text-ink-soft tabular-nums';
				number.textContent = `${i + 1}.`;
				const name = document.createElement('td');
				name.className = 'border-l-2 border-trail/50 px-3 py-0.5 font-hand text-2xl leading-tight';
				name.textContent = person.name;
				if (person.you) {
					const you = document.createElement('span');
					you.className = 'ml-2 font-news text-sm text-ink-soft';
					you.textContent = '(vy)';
					name.append(you);
				}
				const mark = document.createElement('td');
				mark.className = 'px-2 py-0.5 text-center font-hand text-3xl leading-none ' + (person.coming ? 'text-water' : 'text-trail');
				mark.textContent = person.coming ? '✓' : '✗';
				mark.setAttribute('aria-label', person.coming ? 'přijede' : 'nepřijede');
				tr.append(number, name, mark);
				rows.append(tr);
			});
			const coming = people.filter((p) => p.coming).length;
			$('sheet-sum').textContent = `Přijede: ${coming} · Nepřijede: ${people.length - coming}`;
			show($('sheet'));
		}

		// Answer link from the e-mail: https://gis20.cz/#odpoved=<token> (or #odhlasit=<token> from older e-mails).
		// Coming and not coming are equally valid answers, so the panel switches both ways.
		const token = location.hash.match(/^#(?:odpoved|odhlasit)=([a-f0-9]{16,64})$/)?.[1];
		if (token) {
			const choices = [...root.querySelectorAll<HTMLButtonElement>('[data-rsvp-answer-choice]')];
			const showAnswer = (coming: boolean) =>
				choices.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.rsvpAnswerChoice === 'yes') === coming)));
			show(form, false);
			show($('lost'), false);
			root.scrollIntoView();
			call('/answer', { token })
				.then((data) => {
					$('answer-name').textContent = data.name;
					$<HTMLAnchorElement>('answer-sheet').href = `#listina=${data.sheet}`;
					showAnswer(data.coming);
					show($('answer'));
				})
				.catch((err) => fail(message(err)));

			choices.forEach((choice) =>
				choice.addEventListener('click', async () => {
					if (choice.getAttribute('aria-pressed') === 'true') return;
					choices.forEach((b) => (b.disabled = true));
					show(error, false);
					try {
						const data = await call('/answer', { token, attending: choice.dataset.rsvpAnswerChoice });
						showAnswer(data.coming);
						$('answer-stamp').textContent = data.coming ? 'Zapsáno' : 'Omluvenka';
						$('answer-text').textContent =
							(data.coming ? 'Díky, počítáme s vámi! Uvidíme se ve sklepě.' : 'Škoda, budete chybět!') +
							(data.mailed ? ' Potvrzení přišlo na e-mail.' : '');
						show($('answer-saved'));
						setCount(data.count);
					} catch (err) {
						fail(message(err));
					}
					choices.forEach((b) => (b.disabled = false));
				}),
			);
		}
	}
</script>
