---
import type { ClippingArt } from '../data/clippings';

// Small line drawings with a halftone fill, printed-newspaper style.
interface Props {
	art: ClippingArt;
	id: string;
}

const { art, id } = Astro.props;
const dots = `ht-${id}`;
const fill = `url(#${dots})`;

// Salami: white fat specks spread over a cut face (sunflower layout, deterministic).
const specks = (rx: number, ry: number, n: number) =>
	Array.from({ length: n }, (_, i) => {
		const r = Math.sqrt((i + 0.5) / n);
		const a = i * 2.39996;
		return { x: rx * 0.74 * r * Math.cos(a), y: ry * 0.84 * r * Math.sin(a), s: 0.75 + ((i * 37) % 10) / 14 };
	});
const faceSpecks = specks(8.5, 21, 22);
const sliceSpecks = specks(7.2, 18.5, 18);
// Ruler under the salami: one full salami = one unit.
const ticks = Array.from({ length: 27 }, (_, i) => ({ x: 16 + i * 6.5, h: i % 10 === 0 ? 7 : i % 5 === 0 ? 5 : 3 }));
---

<svg viewBox="0 0 200 110" class="h-auto w-full text-ink" aria-hidden="true">
	<defs>
		<pattern id={dots} width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
			<circle cx="2.5" cy="2.5" r="1.35" fill="currentColor"></circle>
		</pattern>
	</defs>
	<g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
		{
			art === 'wine' && (
				<>
					{[
						{ x: 74, r: 14 },
						{ x: 126, r: -14 },
					].map((g) => (
						<g transform={`translate(${g.x} 56) rotate(${g.r})`}>
							<path d="M-21 -12C-20 6-12 16 0 16S20 6 21-12Z" fill={fill} stroke="none" />
							<path d="M-23 -36C-25 0-14 16 0 16S25 0 23-36Z" />
							<path d="M-21 -12H21M0 16V46M-15 48H15" />
						</g>
					))}
					<path d="M100 8v10M88 12l5 7M112 12l-5 7" />
				</>
			)
		}
		{
			art === 'salami' && (
				<>
					{/* ruler */}
					<rect x="12" y="88" width="180" height="15" fill="#f4ecd8" stroke-width="1.3" />
					<path d={ticks.map((t) => `M${t.x} 88v${t.h}`).join('')} stroke-width="1.1" />
					<g fill="currentColor" stroke="none" font-family="Oswald Variable, sans-serif" font-size="7.5" font-weight="600">
						<text x="16" y="101" text-anchor="middle">0</text>
						<text x="81" y="101" text-anchor="middle">½</text>
						<text x="146" y="101" text-anchor="middle">1 VYS</text>
					</g>

					{/* tied end */}
					<path d="M17 44L10 47.5V54.5L17 58Z" fill="#f4ecd8" stroke-width="1.8" />
					<path d="M10 51C3 47 2 40 7 35M10 51C4 55 3 62 7 67" stroke-width="1.6" />

					{/* body: casing with halftone shadow along the bottom */}
					<path d="M28 30H146V72H28C20 72 16 62 16 51S20 30 28 30Z" fill="#f4ecd8" stroke="none" />
					<path d="M16.6 57C18 66 22 72 28 72H146V59C110 63 60 63 16.6 57Z" fill={fill} stroke="none" />
					<path d="M52 31c3 5 3 10 1 15M86 31c2 4 2 8 1 12M118 72c-2-5-2-9 0-13M70 72c-2-4-2-7 0-10" stroke-width="1.1" opacity="0.7" />
					<path d="M28 30H146V72H28C20 72 16 62 16 51S20 30 28 30Z" />

					{/* cut face */}
					<g transform="translate(146 51)">
						<ellipse rx="8.5" ry="21" fill="#f4ecd8" stroke="none" />
						<ellipse rx="8.5" ry="21" fill={fill} stroke="none" />
						<g fill="#fbf6ea" stroke="none">{faceSpecks.map((p) => <circle cx={p.x} cy={p.y} r={p.s} />)}</g>
						<ellipse rx="8.5" ry="21" stroke-width="2.6" />
					</g>

					{/* two slices */}
					{[
						{ x: 167, y: 57, r: -12 },
						{ x: 186, y: 66, r: -26 },
					].map((sl) => (
						<g transform={`translate(${sl.x} ${sl.y}) rotate(${sl.r})`}>
							<ellipse rx="7.2" ry="18.5" fill="#f4ecd8" stroke="none" />
							<ellipse rx="7.2" ry="18.5" fill={fill} stroke="none" />
							<g fill="#fbf6ea" stroke="none">{sliceSpecks.map((p) => <circle cx={p.x} cy={p.y} r={p.s} />)}</g>
							<ellipse rx="7.2" ry="18.5" stroke-width="2.2" />
						</g>
					))}
				</>
			)
		}
		{
			art === 'pole' && (
				<>
					{/* beer bottle with the cap popping off */}
					<path d="M70 104V64C70 54 77 50 77 42V32H87V42C87 50 94 54 94 64V104Z" fill={fill} />
					<rect x="73" y="70" width="18" height="20" fill="#f4ecd8" stroke-width="1.6" />
					<rect x="76" y="14" width="12" height="6" rx="1.5" fill="currentColor" transform="rotate(-24 82 17)" />
					<path d="M70 22l-6-5M94 22l6-6M82 9V3" stroke-width="1.6" />
					{/* range pole, striped, its spike at the bottle neck */}
					<g transform="translate(90 33) rotate(-16)">
						<path d="M0 0L11-3.8V3.8Z" fill="currentColor" />
						{[0, 1, 2, 3, 4].map((i) => (
							<rect x={11 + i * 20} y="-4" width="20" height="8" fill={i % 2 ? '#f4ecd8' : fill} />
						))}
						<rect x="11" y="-4" width="100" height="8" />
					</g>
				</>
			)
		}
		{
			art === 'swatch' && (
				<>
					{/* three proofs of brown contour lines on tracing paper, each browner, none brown enough */}
					{[
						{ x: 12, color: '#c9a273', label: 'hnědá' },
						{ x: 74, color: '#9a6a3a', label: 'hnědší' },
						{ x: 136, color: '#6b4220', label: 'pořád málo' },
					].map((sw) => (
						<g>
							<rect x={sw.x} y="10" width="52" height="66" fill="#f8f5ec" stroke-width="1.4" />
							<path
								d={`M${sw.x + 5} 22c12-7 28 5 42-2M${sw.x + 5} 35c13-9 27 7 42-3M${sw.x + 5} 48c11-6 30 6 42-2M${sw.x + 5} 62c13-8 27 6 42-3`}
								stroke={sw.color}
								stroke-width="2.4"
							/>
							<text
								x={sw.x + 26}
								y="94"
								text-anchor="middle"
								fill="currentColor"
								stroke="none"
								font-family="Oswald Variable, sans-serif"
								font-size="11"
								font-weight="600"
							>
								{sw.label}
							</text>
						</g>
					))}
				</>
			)
		}
		{
			art === 'globe' && (
				<>
					<circle cx="100" cy="55" r="46" fill={fill} />
					<ellipse cx="100" cy="55" rx="20" ry="46" />
					<path d="M100 9v92M54 55h92M60 33h80M60 77h80" />
					<path d="M150 20l18-10M158 30l22-4" stroke-dasharray="3 5" />
				</>
			)
		}
		{
			art === 'puck' && (
				<>
					<path d="M50 52v18c0 10 22 18 50 18s50-8 50-18V52" fill={fill} />
					<ellipse cx="100" cy="52" rx="50" ry="18" fill="#f4ecd8" />
					<text
						x="100"
						y="60"
						text-anchor="middle"
						fill="currentColor"
						stroke="none"
						font-family="Oswald Variable, sans-serif"
						font-weight="700"
						font-size="22"
					>
						3:0
					</text>
				</>
			)
		}
		{
			art === 'floppy' && (
				<>
					<path d="M60 8h70l14 14v80H60z" fill={fill} />
					<rect x="80" y="8" width="44" height="30" fill="#f4ecd8" />
					<rect x="108" y="13" width="9" height="20" fill="currentColor" />
					<rect x="72" y="58" width="60" height="44" fill="#f4ecd8" />
					<path d="M80 70h44M80 80h44M80 90h28" />
				</>
			)
		}
		{
			art === 'satellite' && (
				<>
					<rect x="84" y="38" width="32" height="34" fill={fill} />
					<rect x="20" y="44" width="56" height="22" />
					<rect x="124" y="44" width="56" height="22" />
					<path d="M34 44v22M48 44v22M62 44v22M138 44v22M152 44v22M166 44v22M76 55h8M116 55h8" />
					<path d="M100 72v12M88 96c6-8 18-8 24 0" />
					<path d="M60 96c10-12 30-18 40-18M140 96c-10-12-30-18-40-18" stroke-dasharray="2 5" />
				</>
			)
		}
	</g>
</svg>
