---
import Base from '../layouts/Base.astro';
import Clipping from '../components/Clipping.astro';
import Countdown from '../components/Countdown.astro';
import RouteMap from '../components/RouteMap.astro';
import RsvpSlip from '../components/RsvpSlip.astro';
import Scrap from '../components/Scrap.astro';
import { clippings } from '../data/clippings';
import { SYMBOLS } from '../lib/contours';
import {
	distanceKm,
	event,
	formatCoord,
	formatCzk,
	formatDateRange,
	formatDateRangeLong,
	formatWeekdays,
	mapLinks,
} from '../data/event';

const startDate = new Date(event.start.y, event.start.m - 1, event.start.d);
const dateline = startDate.toLocaleDateString('cs-CZ', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
const month = startDate.toLocaleDateString('cs-CZ', { month: 'long' });
const dateRange = formatDateRange();
const dateRangeLong = formatDateRangeLong();
const weekdays = formatWeekdays().replace('–', ' a ');
const price = formatCzk(event.price);
const { lat, lon } = event.venueCoords;
const coords = `${formatCoord(lat, 'lat')}, ${formatCoord(lon, 'lon')}`;
const links = mapLinks(event.venueCoords);
const km = Math.round(distanceKm(event.schoolCoords, event.venueCoords));

const title = `${event.title}, ${dateRange}`;
const description = `Pozvánka na sraz absolventů oboru ${event.field} z VŠB-TUO ${event.yearsSince} let od promocí: ${dateRangeLong}, vinný sklep v Dolních Bojanovicích, ${price} za víno a jídlo.`;

const button =
	'inline-block border-2 border-ink px-4 py-2 font-cond text-lg font-semibold leading-tight transition-colors hover:bg-ink hover:text-news';
const inlineLink = 'underline decoration-1 underline-offset-4 transition-colors hover:text-trail';
// Footer title block: fields with small labels, as in the corner of a map sheet.
const cell = 'px-4 py-3.5 sm:px-5';
const fieldLabel = 'font-cond text-xs font-semibold tracking-[0.14em] text-ink-soft uppercase';
const footerLink = 'font-semibold underline decoration-1 underline-offset-4 transition-colors hover:text-trail';
---

<Base title={title} description={description}>
	<!-- The front page keeps the footer's width (max-w-6xl minus padding); the archive below uses the full width. -->
	<main class="overflow-x-clip px-4 pt-10 pb-16 sm:px-6 lg:pt-16">
		<div class="mx-auto grid max-w-[69rem] items-start gap-x-10 gap-y-14 lg:grid-cols-12">
			<!-- Front page of a made-up newspaper: the invitation itself -->
			<Scrap
				seed={1}
				rotate={-1.2}
				attach="tape-corners"
				class="lg:col-span-7"
				innerClass="@container px-5 pt-7 pb-9 sm:px-9 sm:pt-9 sm:pb-11"
			>
				<header>
					<p class="py-2 text-center text-[clamp(2.1rem,9vw,3.75rem)] leading-none font-extrabold tracking-tight">
						<a href="/" class="decoration-[0.06em] underline-offset-[0.12em] hover:underline">Gisácký sraz</a>
					</p>
					<!-- One line down to ~380px; on narrower phones the date moves to its own line, flush right. -->
					<div class="flex flex-wrap justify-between gap-x-4 border-y-[3px] border-double border-ink py-1 text-[0.8125rem] sm:text-base">
						<span class="whitespace-nowrap">Ostrava – Dolní Bojanovice</span>
						<span class="ml-auto whitespace-nowrap first-letter:uppercase">{dateline}</span>
					</div>
				</header>

				<h1 class="mt-6 text-[clamp(2.6rem,17cqi,7.4rem)] leading-[0.95] font-extrabold tracking-[-0.03em]">
					Sraz po {event.yearsSince}&nbsp;letech
				</h1>
				<p class="mt-5 max-w-[34ch] text-xl leading-snug italic sm:text-2xl">
					Po dvaceti letech se ročník geoinformatiky z&nbsp;ostravské VŠB znovu protne v&nbsp;jednom bodě: ve vinném sklepě v&nbsp;<a
						href={links.mapy}
						target="_blank"
						rel="noopener"
						title="Ukázat na mapě"
						class={inlineLink}>Dolních Bojanovicích</a
					>, <span class="whitespace-nowrap">{dateRangeLong}</span>.
				</p>

				<div class="mt-7 border-t border-ink/60 pt-5">
					<div class="max-w-[60ch] text-[1.1875rem] leading-relaxed text-pretty hyphens-auto">
						<p
							class="first-letter:float-left first-letter:mt-1 first-letter:mr-2 first-letter:text-[3.6rem] first-letter:leading-[0.8] first-letter:font-bold"
						>
							Dvacet let je dost dlouhá doba (joj, to to letí!), abychom se zase <span class="whitespace-nowrap">sešli –</span> tentokrát u&nbsp;vína, případně piva na jižní Moravě.
						</p>
						<p class="mt-3">
							Sklípek, víno i&nbsp;jídlo jsou v&nbsp;ceně {price} na osobu. Můžeme zajistit taky pivo. Čas začátku, platbu a&nbsp;další podrobnosti
							ještě upřesníme e-mailem.
						</p>
						<p class="mt-3">Nocleh si zajistěte po vlastní ose. Případně se můžeme pokusit domluvit dle zájmu něco v&nbsp;okolí.</p>
					</div>
				</div>

				<!-- Calls to action; the RSVP button only when the slip is shown (see rsvpApi) -->
				<div class="mt-7 flex flex-wrap gap-4">
					{
						event.rsvpApi && (
							<a
								href="#prihlaska"
								class="inline-flex items-center gap-3 border-2 border-trail bg-trail px-6 py-3 font-cond text-lg font-semibold tracking-wide text-white uppercase transition-colors hover:border-ink hover:bg-ink"
							>
								Potvrdit účast
								<svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M5 12h14M13 6l6 6-6 6" />
								</svg>
							</a>
						)
					}
					<!-- No `download` attribute on .ics links: with it Safari on iPhone saves the file to Files
					     instead of offering to add the event to the calendar. -->
					<a
						href="/sraz.ics"
						class="inline-flex items-center gap-3 border-2 border-ink px-6 py-3 font-cond text-lg font-semibold tracking-wide uppercase transition-colors hover:bg-ink hover:text-news"
					>
						<svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="3" y="5" width="18" height="16" rx="2" />
							<path d="M3 10h18M8 3v4M16 3v4" />
						</svg>
						Uložit do kalendáře
					</a>
				</div>
			</Scrap>

			<!-- Date, countdown and price as objects pinned next to the front page -->
			<div class="mx-auto grid w-full max-w-xl grid-cols-2 items-start gap-x-5 gap-y-10 lg:col-span-5 lg:mx-0 lg:max-w-none lg:pt-4">
				<Scrap seed={2} rotate={2.4} edges="torn-top" paper="#fffdf6" attach="pin" innerClass="pb-5 text-center">
					<p class="bg-trail pt-4 pb-2 font-cond text-xl font-semibold text-white first-letter:uppercase">
						{month}&nbsp;{event.start.y}
					</p>
					<p class="mt-3 font-cond text-[clamp(2.4rem,10vw,3.6rem)] leading-none font-bold tracking-tight">
						{event.start.d}.–{event.end.d}.
					</p>
					<p class="mt-1 text-lg">{weekdays}</p>
					<a href="/sraz.ics" class:list={[button, 'mt-4 text-base']}>
						Uložit do kalendáře
					</a>
				</Scrap>

				<Scrap
					seed={3}
					rotate={-3.5}
					edges="straight"
					paper="var(--color-sticky)"
					attach="none"
					class="mt-10"
					innerClass="flex aspect-square items-center p-4 sm:p-5"
				>
					<Countdown
						class="font-hand leading-none"
						numClass="text-[clamp(1.9rem,8vw,2.6rem)] font-bold"
						labelClass="mt-2 text-[clamp(1.4rem,6vw,1.8rem)]"
					/>
				</Scrap>

				<Scrap
					seed={4}
					rotate={1.8}
					edges="zigzag"
					paper="var(--color-receipt)"
					attach="tape"
					class="col-span-2 w-full max-w-[17rem] justify-self-center"
					innerClass="px-5 pt-6 pb-8 font-mono text-[0.875rem] leading-relaxed uppercase"
				>
					<p class="-mt-1 mb-3 -rotate-3 text-center font-hand text-[1.7rem] leading-none font-bold text-water normal-case">
						Kolik to stojí?
					</p>
					<p class="text-center font-bold">{event.venue}</p>
					<p class="text-center">{event.town}</p>
					<p class="text-center">{dateRange}</p>
					<p class="my-2 overflow-hidden whitespace-nowrap text-ink-soft" aria-hidden="true">
						- - - - - - - - - - - - - - - - - - - -
					</p>
					<p class="flex justify-between"><span>Víno</span><span>v ceně</span></p>
					<p class="flex justify-between"><span>Jídlo</span><span>v ceně</span></p>
					<p class="my-2 overflow-hidden whitespace-nowrap text-ink-soft" aria-hidden="true">
						- - - - - - - - - - - - - - - - - - - -
					</p>
					<p class="flex justify-between text-base font-bold"><span>Celkem</span><span class="normal-case">{price}</span></p>
					<p class="text-right">za osobu</p>
					<p class="mt-3 text-center normal-case">Na zdraví!</p>
				</Scrap>
			</div>

			<!-- Where: newspaper note + torn piece of map -->
			<Scrap seed={5} rotate={1.5} attach="pin" class="lg:col-span-5 lg:mt-10" innerClass="px-6 pt-7 pb-8">
				<h2 class="text-[2rem] leading-[1.05] font-bold tracking-tight">Z Báňské až do sklepa</h2>
				<p class="mt-3 text-[1.1875rem] leading-relaxed">
					Sejdeme se ve vinném sklepě v&nbsp;Dolních Bojanovicích. Z&nbsp;Ostravy je to vzdušnou čarou asi {km}&nbsp;km. Po silnici to
					bude víc, ale trasu si jako gisáci spočítá každý sám.
				</p>
				<p class="mt-4 text-base text-ink-soft">Souřadnice sklepa: <span class="font-mono">{coords}</span></p>
				<p class="mt-4 flex flex-wrap gap-3">
					<a href={links.mapy} target="_blank" rel="noopener" class={button}>Otevřít v Mapy.com</a>
					<a href={links.osm} target="_blank" rel="noopener" class={button}>OpenStreetMap</a>
				</p>
			</Scrap>

			<Scrap
				seed={6}
				rotate={-1.6}
				paper="#f4f1e1"
				attach="tape-corners"
				class="lg:col-span-7"
				innerClass="px-4 pt-6 pb-6 sm:px-6"
			>
				<RouteMap />
			</Scrap>
		</div>

		<RsvpSlip />

		<!-- Archive of fake clippings -->
		<section aria-labelledby="archiv" class="mt-24">
			<div class="mb-12 flex justify-center">
				<Scrap seed={8} rotate={-2} edges="cut" paper="#fffdf6" attach="pin" innerClass="px-7 py-4 text-center">
					<h2 id="archiv" class="text-3xl font-bold sm:text-4xl">Z gisákova archivu</h2>
					<p class="mt-1 text-ink-soft italic">útržky z&nbsp;doby, kdy se data nosila na disketách</p>
				</Scrap>
			</div>
			<div class="flex flex-wrap items-start justify-center gap-x-6 gap-y-10 sm:gap-x-3 sm:gap-y-6">
				{clippings.map((clipping, i) => <Clipping clipping={clipping} seed={10 + i} />)}
			</div>
		</section>

	</main>

	<!-- The footer is the title block from the corner of a map sheet, pinned to the board like the other scraps
	     (a double neatline and labelled fields: sheet, questions, legend), with the approval stamp next to it on the map. -->
	<footer class="mx-auto flex max-w-[69rem] flex-col gap-10 overflow-x-clip px-4 pb-14 sm:px-6 xl:flex-row xl:items-center">
		<Scrap
			seed={40}
			rotate={-0.4}
			edges="straight"
			paper="#fbfaf5"
			attach="tape-corners"
			class="w-full xl:flex-1"
			innerClass="p-2 sm:p-2.5"
		>
			<div class="grid border-[3px] border-double border-ink sm:grid-cols-2 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)_minmax(0,1.6fr)]">
				<div class={cell}>
					<p class={fieldLabel}>Mapový list</p>
					<p class="mt-1 text-2xl leading-tight font-bold">Gisácký sraz</p>
					<p class="mt-1.5 text-[0.9375rem] leading-snug">
						Sraz po {event.yearsSince}&nbsp;letech od promocí, <span class="whitespace-nowrap">{dateRangeLong}</span>, vinný sklep
						v&nbsp;Dolních Bojanovicích.
					</p>
					<p class="mt-2 font-mono text-[0.8125rem] text-ink-soft">Měřítko 1 : {event.yearsSince} let</p>
				</div>

				{
					(event.contactEmail || event.contactPhone) && (
						<div class:list={[cell, 'border-t border-ink/50 sm:border-t-0 sm:border-l']}>
							<h2 class={fieldLabel}>Dotazy</h2>
							{event.contactEmail && (
								<p class="mt-1.5">
									Pište na{' '}
									<a class={footerLink} href={`mailto:${event.contactEmail}`}>
										{event.contactEmail}
									</a>
								</p>
							)}
							{event.contactPhone && (
								<p class="mt-1">
									Volejte na{' '}
									<a class={footerLink} href={`tel:${event.contactPhone.replace(/\s/g, '')}`}>
										{event.contactPhone}
									</a>
								</p>
							)}
						</div>
					)
				}

				<div class:list={[cell, 'border-t border-ink/50 sm:col-span-2 lg:col-span-1 lg:border-t-0 lg:border-l']}>
					<h2 class={fieldLabel}>Legenda</h2>
					<ul class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1.5 text-[0.9375rem] leading-snug">
						<li class="flex items-center gap-2">
							<svg viewBox="0 0 28 10" class="h-2.5 w-7 shrink-0" aria-hidden="true"
								><path d="M1 7c6-6 10 2 26-4" fill="none" stroke="#b98a57" stroke-width="1.7"></path></svg
							>
							vrstevnice
						</li>
						<li class="flex items-center gap-2">
							<svg viewBox="0 0 28 10" class="h-2.5 w-7 shrink-0" aria-hidden="true"
								><path d="M1 5h26" stroke="#8a7a68" stroke-width="6"></path><path d="M1 5h26" stroke="#f3d68a" stroke-width="4"></path></svg
							>
							silnice
						</li>
						<li class="flex items-center gap-2">
							<svg viewBox="0 0 28 10" class="h-2.5 w-7 shrink-0" aria-hidden="true"
								><path d="M1 5h26" stroke="#c8332f" stroke-width="2.2" stroke-dasharray="5 3"></path></svg
							>
							turistická trasa
						</li>
						<li class="flex items-center gap-2">
							<svg viewBox="0 0 28 10" class="h-2.5 w-7 shrink-0" aria-hidden="true"
								><path d="M1 6c8-4 14 2 26-2" fill="none" stroke="#9cc6e4" stroke-width="6"></path></svg
							>
							vodní tok
						</li>
						<li class="flex items-center gap-2">
							<svg viewBox="0 0 28 10" class="h-2.5 w-7 shrink-0" aria-hidden="true"
								><rect x="1" y="1" width="26" height="8" rx="3" fill="#d3e2bd"></rect></svg
							>
							les
						</li>
						<li class="flex items-center gap-2">
							<svg viewBox="0 0 28 10" class="h-2.5 w-7 shrink-0" aria-hidden="true"><path d="M14 1.5l4.5 7.5h-9z" fill="#6b4a2b"></path></svg>
							kóta
						</li>
						<li class="flex items-center gap-2">
							<svg viewBox="-14 -6 28 12" class="h-3 w-7 shrink-0" fill="#7a5a3c" aria-hidden="true"><g set:html={SYMBOLS.pub} /></svg>
							hospoda
						</li>
						<li class="flex items-center gap-2">
							<svg viewBox="-14 -6 28 12" class="h-3 w-7 shrink-0" fill="#7a5a3c" aria-hidden="true"><g set:html={SYMBOLS.bar} /></svg>
							bar
						</li>
						<li class="flex items-center gap-2">
							<svg viewBox="-14 -6 28 12" class="h-3 w-7 shrink-0" fill="#7a5a3c" aria-hidden="true"><g set:html={SYMBOLS.hut} /></svg>
							chata
						</li>
					</ul>
				</div>
			</div>
		</Scrap>

		<!-- Approval stamp, as in the corner of a map sheet; the darker red keeps it readable over the contours. -->
		<div class="-rotate-6 self-start pl-2 xl:self-center">
			<p
				class="border-[3px] border-trail-dark/90 px-5 py-2.5 font-cond text-lg leading-snug font-semibold tracking-wide whitespace-nowrap text-trail-dark uppercase"
			>
				Mapové podklady<br />schválil Ozzy
			</p>
		</div>
	</footer>
</Base>
