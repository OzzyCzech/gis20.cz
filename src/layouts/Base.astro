---
import '@fontsource-variable/caveat';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/oswald';
import '../styles/global.css';
// Preload the Latin subsets (Czech needs latin-ext too) so text renders in its own font right away
// instead of flashing the fallback; the ?url imports resolve to the same hashed files the CSS uses.
import caveatLatin from '@fontsource-variable/caveat/files/caveat-latin-wght-normal.woff2?url';
import caveatLatinExt from '@fontsource-variable/caveat/files/caveat-latin-ext-wght-normal.woff2?url';
import newsreaderLatin from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import newsreaderLatinExt from '@fontsource-variable/newsreader/files/newsreader-latin-ext-wght-normal.woff2?url';
import oswaldLatin from '@fontsource-variable/oswald/files/oswald-latin-wght-normal.woff2?url';
import oswaldLatinExt from '@fontsource-variable/oswald/files/oswald-latin-ext-wght-normal.woff2?url';

const fonts = [newsreaderLatin, newsreaderLatinExt, oswaldLatin, oswaldLatinExt, caveatLatin, caveatLatinExt];

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
// Link preview image; source in scripts/og-image.html. Crawlers need an absolute URL.
// Bump ?v= whenever public/og.png changes: link previews (Facebook, WhatsApp…) cache the image by its URL.
const ogImage = new URL('/og.png?v=2', Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="cs">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{fonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
		<title>{title}</title>
		<meta name="description" content={description} />
		<!-- Private invitation: keep it out of search engines (see also public/robots.txt). -->
		<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
		{canonical && <link rel="canonical" href={canonical} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#edead8" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="cs_CZ" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Titulní strana pozvánky Gisácký sraz: Sraz po 20 letech, 19.–20. června 2027, víno i jídlo 1 100 Kč" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body class="min-h-dvh antialiased">
		<slot />
	</body>
</html>
